# ============================================================
# ARPT Guinee - Configuration Environnement
# ============================================================
# Copiez ce fichier en .env et adaptez les valeurs :
#   cp .env.example .env          (Linux/Mac)
#   copy .env.example .env        (Windows)
#
# DEV LOCAL (SQLite - sans Docker) :
#   1. cp .env.example .env
#   2. npx prisma db push
#   3. npx prisma generate
#   4. npm run db:seed
#   5. npm run dev
#
# DOCKER (PostgreSQL + Redis) :
#   1. cp .env.example .env
#   2. Changez les mots de passe dans .env
#   3. docker compose up -d
# ============================================================

# ── Base de donnees ──────────────────────────────────────
# SQLite (dev local) - la DB est stockee dans ./db/custom.db
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (Docker/production) - decommentez la ligne ci-dessous
# et commentez la ligne SQLite ci-dessus
# DATABASE_URL=postgresql://arpt_user:arpt_password_2025@localhost:5432/arpt_guinee?schema=public

# ── Authentification ─────────────────────────────────────
# IMPORTANT : changez ces secrets en production !
# Generer un secret : openssl rand -base64 32
NEXTAUTH_SECRET=arpt-dev-secret-changez-en-production
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=arpt-jwt-secret-changez-en-production
SESSION_SECRET=arpt-session-secret-changez-en-production

# ── PostgreSQL (Docker uniquement) ───────────────────────
# Ces variables sont necessaires pour docker compose up
POSTGRES_USER=arpt_user
POSTGRES_PASSWORD=arpt_password_2025
POSTGRES_DB=arpt_guinee

# ── Redis (Docker uniquement - optionnel en dev) ─────────
# L'app fonctionne sans Redis (fallback en memoire)
REDIS_URL=redis://localhost:6379

# ── Environnement ────────────────────────────────────────
NODE_ENV=development
