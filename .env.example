# ============================================
# ARPT Guinée - Configuration Environnement
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================

# Base de données (SQLite pour dev local)
DATABASE_URL=file:./db/custom.db

# Pour PostgreSQL (Docker), utilisez :
# DATABASE_URL=postgresql://arpt_user:VOTRE_MOT_DE_PASSE@localhost:5432/arpt_guinee?schema=public

# Authentification
NEXTAUTH_SECRET=changez-ce-secret-en-production
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=changez-ce-secret-jwt-en-production
SESSION_SECRET=changez-ce-secret-session-en-production

# PostgreSQL (Docker)
POSTGRES_USER=arpt_user
POSTGRES_PASSWORD=VOTRE_MOT_DE_PASSE_POSTGRES
POSTGRES_DB=arpt_guinee

# Redis (Docker - optionnel)
REDIS_URL=redis://localhost:6379

# Environnement
NODE_ENV=development
