# ============================================================
# ARPT Guinee - Configuration Environnement
# ============================================================
# Ce fichier est un TEMPLATE. Copiez-le et renommez-le :
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/Mac)
#
# DEV LOCAL (SQLite - sans Docker) :
#   1. copy .env.example .env
#   2. npx prisma db push
#   3. npx prisma generate
#   4. npm run db:seed
#   5. npm run dev
#
# DOCKER (PostgreSQL + Redis) :
#   1. copy .env.example .env
#   2. Changez DATABASE_URL pour PostgreSQL (decommentez ci-dessous)
#   3. Changez les mots de passe dans la section PostgreSQL
#   4. docker compose up -d
#
# PRODUCTION : changez TOUS les secrets avec :
#   openssl rand -base64 32
# ============================================================

# ── Base de donnees ──────────────────────────────────────
# SQLite (dev local) - la DB est stockee dans ./db/custom.db
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (Docker/production) - decommentez la ligne ci-dessous
# et commentez la ligne SQLite ci-dessus pour utiliser Docker
# DATABASE_URL="postgresql://arpt_user:arpt_password_2025@localhost:5432/arpt_guinee?schema=public"

# ── Authentification ─────────────────────────────────────
# NEXTAUTH_SECRET : secret pour NextAuth.js (sessions JWT)
# Generer un nouveau : openssl rand -base64 32
NEXTAUTH_SECRET=arpt-dev-secret-7f3k9m2x8p4q1w6r

# NEXTAUTH_URL : URL de base de l'application
NEXTAUTH_URL=http://localhost:3000

# JWT_SECRET : secret pour la signature des JWT (api-handler, middleware)
# Utilise aussi par jose dans jwt-auth.ts
JWT_SECRET=arpt-jwt-secret-5n8v2c9t1m4x7b3y

# SESSION_SECRET : secret de secours pour les sessions
# jwt-auth.ts fallback : JWT_SECRET || SESSION_SECRET || "fallback-secret-change-me"
SESSION_SECRET=arpt-session-secret-6j2h9k4p8r3w5x1z

# ── PostgreSQL (Docker uniquement) ───────────────────────
# Necessaires pour : docker compose up
# Ces variables sont passees au container postgres via docker-compose.yml
POSTGRES_USER=arpt_user
POSTGRES_PASSWORD=arpt_password_2025
POSTGRES_DB=arpt_guinee

# ── Redis (Docker - optionnel en dev) ────────────────────
# L'app fonctionne sans Redis (fallback en memoire dans rate-limiter)
# En dev local sans Docker, cette variable est ignoree
REDIS_URL=redis://localhost:6379

# ── Logging ──────────────────────────────────────────────
# Niveaux : debug | info | warn | error
# Defaut : debug en dev, info en prod (voir src/lib/logger.ts)
LOG_LEVEL=debug

# ── Environnement ────────────────────────────────────────
# development | production | test
NODE_ENV=development
