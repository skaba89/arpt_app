# ============================================================
# ARPT Guinee - Configuration Environnement
# ============================================================
# DEV LOCAL (SQLite - sans Docker) :
#   1. copy .env.example .env        (Windows)
#       cp .env.example .env          (Linux/Mac)
#   2. npx prisma db push
#   3. npx prisma generate
#   4. npm run db:seed
#   5. npm run dev
#
# DOCKER (PostgreSQL + Redis) :
#   1. copy .env.example .env
#   2. Changez les mots de passe ci-dessous
#   3. docker compose up -d
#
# PRODUCTION : changez TOUS les secrets avec openssl rand -base64 32
# ============================================================

# ── Base de donnees ──────────────────────────────────────
# SQLite (dev local) - la DB est stockee dans ./db/custom.db
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (Docker/production) - decommentez et commentez SQLite ci-dessus
# DATABASE_URL="postgresql://arpt_user:arpt_password_2025@localhost:5432/arpt_guinee?schema=public"

# ── Authentification ─────────────────────────────────────
# Generer un secret : openssl rand -base64 32
NEXTAUTH_SECRET=arpt-dev-secret-7f3k9m2x8p4q1w6r
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=arpt-jwt-secret-5n8v2c9t1m4x7b3y
SESSION_SECRET=arpt-session-secret-6j2h9k4p8r3w5x1z

# ── PostgreSQL (Docker uniquement) ───────────────────────
# Necessaires pour : docker compose up
POSTGRES_USER=arpt_user
POSTGRES_PASSWORD=arpt_password_2025
POSTGRES_DB=arpt_guinee

# ── Redis (Docker - optionnel en dev) ────────────────────
# L'app fonctionne sans Redis (fallback en memoire)
REDIS_URL=redis://localhost:6379

# ── Logging ──────────────────────────────────────────────
# debug | info | warn | error (defaut: debug en dev, info en prod)
LOG_LEVEL=debug

# ── Environnement ────────────────────────────────────────
NODE_ENV=development
