# ============================================================
# ARPT Guinee - Configuration Environnement (DEV)
# ============================================================

# Base de donnees - SQLite pour dev local
DATABASE_URL="file:./db/custom.db"

# Pour PostgreSQL (Docker), decommentez :
# DATABASE_URL=postgresql://arpt_user:arpt_password_2025@localhost:5432/arpt_guinee?schema=public

# Authentification
NEXTAUTH_SECRET=arpt-dev-secret-changez-en-production
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=arpt-jwt-secret-changez-en-production
SESSION_SECRET=arpt-session-secret-changez-en-production

# PostgreSQL (Docker)
POSTGRES_USER=arpt_user
POSTGRES_PASSWORD=arpt_password_2025
POSTGRES_DB=arpt_guinee

# Redis (Docker - optionnel en dev)
REDIS_URL=redis://localhost:6379

# Environnement
NODE_ENV=development
